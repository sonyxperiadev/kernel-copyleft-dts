	tpdm_ipa: tpdm@8b1f000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x8b1f000 0x0 0x1000>;
		reg-names = "tpdm-base";

