				};
			};
		};
	};

	tpdm_qm: tpdm@89d0000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x89d0000 0x0 0x1000>;
		reg-names = "tpdm-base";

