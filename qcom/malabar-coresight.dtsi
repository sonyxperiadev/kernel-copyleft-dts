	tpdm_prng: tpdm@884c000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x884c000 0x0 0x1000>;
		reg-names = "tpdm-base";

		device-name = "tpdm-prng";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
