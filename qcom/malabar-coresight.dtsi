	};

	tpdm_ddr1: tpdm@8a49000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x8a49000 0x0 0x1000>;
		reg-names = "tpdm-base";

		device-name = "tpdm-ddr1";
		status = "disabled";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		qcom,cmb-elem-size = <64>;
		out-ports {
			port {
				tpdm_ddr1_out_funnel_ddr: endpoint {
					remote-endpoint =
					<&funnel_ddr_in_tpdm_ddr1>;
				};
			};
		};
	};

	tpdm_mapss: tpdm@8a01000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x8a01000 0x0 0x1000>;
		reg-names = "tpdm-base";

		device-name = "tpdm-mapss";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		qcom,dsb-elem-size = <32>;
