		};
	};

	tpdm_sdcc2: tpdm@8b20000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x8b20000 0x0 0x1000>;
		reg-names = "tpdm-base";

		qcom,cmb-elem-size = <32>;
