	};

	tpdm_ipcc: tpdm@8b41000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb968>;
		reg = <0x0 0x8b41000 0x0 0x1000>;
		reg-names = "tpdm-base";

		device-name = "tpdm-ipcc";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		qcom,cmb-elem-size = <64>;
		qcom,cmb-msrs-num = <1>;
		out-ports {
