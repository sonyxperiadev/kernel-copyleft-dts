		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x0 0x12191000 0x0 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <32>;
		qcom,cmb-msrs-num = <12>;

		device-name = "tpdm_apss_llm_2";

