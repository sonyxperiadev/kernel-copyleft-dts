&soc {
	ipcb_tgu: tgu@10b0e000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;
		reg = <0x0 0x10b0e000 0x0 0x1000>;
		reg-names = "tgu-base";
		tgu-steps = <2>;
		tgu-conditions = <4>;
		tgu-regs = <4>;

		device-name = "tgu_ipcb";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	spmi_tgu0: tgu@10b0f000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;

		reg = <0x0 0x10b0f000 0x0 0x1000>;
		reg-names = "tgu-base";

		tgu-steps = <3>;
		tgu-conditions = <4>;
		tgu-regs = <8>;

		device-name = "tgu_spmi0";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	spmi_tgu1: tgu@10b10000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;

		reg = <0x0 0x10b10000 0x0 0x1000>;
		reg-names = "tgu-base";

		tgu-steps = <2>;
		tgu-conditions = <4>;
		tgu-regs = <8>;

		device-name = "tgu_spmi1";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	csr: csr@10001000 {
		compatible = "qcom,coresight-csr";
		reg = <0x0 0x10001000 0x0 0x1000>;
		reg-names = "csr-base";

		device-name = "csr";

		qcom,hwctrl-set-support;
		qcom,set-byte-cntr-support;
		qcom,blk-size = <1>;
	};

	swao_csr: csr@10b11000 {
		compatible = "qcom,coresight-csr";
		reg = <0x0 0x10b11000 0x0 0x1000>,
		      <0x0 0x10b110f8 0x0 0x90>;
		reg-names = "csr-base", "msr-base";

		device-name = "swao_csr";

		qcom,timestamp-support;
		qcom,msr-support;
		qcom,blk-size = <1>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	tpdm_spss: tpdm@10880000 {
		compatible = "qcom,coresight-tpdm", "arm,primecell";
		reg = <0x0 0x10880000 0x0 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,cmb-element-bits = <32>;

		device-name = "tpdm_spss";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_spss_out_tpda_spss: endpoint {
					remote-endpoint =
					<&tpda_spss_in_tpdm_spss>;
				};
			};
		};
	};

	tpda_spss: tpda@10882000 {
		compatible = "qcom,coresight-tpda", "arm,primecell";
		reg = <0x0 0x10882000 0x0 0x1000>;
		reg-names = "tpda-base";

		device-name = "tpda_spss";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			port {
				tpda_spss_in_tpdm_spss: endpoint {
					remote-endpoint =
					<&tpdm_spss_out_tpda_spss>;
				};
			};

		};

		out-ports {
			port {
				tpda_spss_out_funnel_spss: endpoint {
					remote-endpoint =
					<&funnel_spss_in_tpda_spss>;
				};
			};
		};
	};

	funnel_spss: funnel@10883000 {
		compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
		reg = <0x0 0x10883000 0x0 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_spss";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				funnel_spss_in_tpda_spss: endpoint {
					remote-endpoint =
					<&tpda_spss_out_funnel_spss>;
				};
			};
		};

		out-ports {
			port {
				funnel_spss_out_funnel_in0: endpoint {
					remote-endpoint =
					<&funnel_in0_in_funnel_spss>;
				};
			};
		};
	};

	tpdm_turing: tpdm@10980000 {
		compatible = "qcom,coresight-tpdm", "arm,primecell";
		reg = <0x0 0x10980000 0x0 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <16>;

		device-name = "tpdm_turing";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_turing_out_funnel_turing: endpoint {
					remote-endpoint =
					<&funnel_turing_in_tpdm_turing>;
				};
			};
		};
	};

	tpdm_turing_llm: tpdm@10981000 {
		compatible = "qcom,coresight-static-tpdm";
		device-name = "tpdm_turing-llm";
		qcom,cmb-element-bits = <32>;

		out-ports {
			port {
				tpdm_turing_llm_out_funnel_turing: endpoint {
					remote-endpoint =
					<&funnel_turing_in_tpdm_turing_llm>;
				};
			};
		};
	};

	turing_etm0: turing-etm0 {
		compatible = "qcom,coresight-remote-etm";

		device-name = "turing_etm0";

		qcom,atid-num = <4>;
		atid = <38 39 40 41>;
		trace-name = "turing-etm0";

		out-ports {
			port@0 {
				reg = <0>;
				turing_etm0_out_funnel_turing: endpoint {
					remote-endpoint =
						<&funnel_turing_in_turing_etm0>;
				};
			};

			port@1 {
				reg = <1>;
				turing_etm0_out_qmi: endpoint {
					remote-endpoint =
						<&qmi_in_turing_etm0>;
				};
			};
		};
	};

	turing-qmi {
		compatible = "qcom,coresight-qmi";

		device-name = "qmi_turing";
		qcom,inst-id = <13>;

		in-ports {
			port {
				qmi_in_turing_etm0: endpoint {
					remote-endpoint =
					<&turing_etm0_out_qmi>;
				};
			};
		};
	};

	funnel_turing: funnel@10983000 {
		compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
		reg = <0x0 0x10983000 0x0 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_turing";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				funnel_turing_in_tpdm_turing: endpoint {
					remote-endpoint =
					<&tpdm_turing_out_funnel_turing>;
				};
			};

			port@1 {
				reg = <1>;
				funnel_turing_in_tpdm_turing_llm: endpoint {
					remote-endpoint =
					<&tpdm_turing_llm_out_funnel_turing>;
				};
			};

			port@4 {
				reg = <4>;
				funnel_turing_in_turing_etm0: endpoint {
					remote-endpoint =
					<&turing_etm0_out_funnel_turing>;
				};
			};
		};

		out-ports {
			port {
				funnel_turing_out_replicator_turing: endpoint {
					remote-endpoint =
					<&replicator_turing_in_funnel_turing>;
				};
			};
		};
	};

	turing_replicator {
		compatible = "arm,coresight-static-replicator";

		device-name = "replicator_turing";

		in-ports {
			port {
				replicator_turing_in_funnel_turing: endpoint {
					remote-endpoint =
					<&funnel_turing_out_replicator_turing>;
				};
			};
		};

		out-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				tpdm_turing_out_tpda_dl_center: endpoint {
				remote-endpoint =
					<&tpda_dl_center_in_tpdm_turing>;
				filter-source= <&tpdm_turing>;
				};
			};

			port@1 {
				reg = <1>;
				tpdm_turing_llm_out_tpda_dl_center: endpoint {
				remote-endpoint =
						<&tpda_dl_center_in_tpdm_turing_llm>;
				filter-source= <&tpdm_turing_llm>;
				};
			};

			port@2 {
				reg = <2>;
				turing_etm0_out_funnel_dl_center: endpoint {
				remote-endpoint =
						<&funnel_dl_center_in_turing_etm0>;
				filter-source = <&turing_etm0>;
				};
			};
		};
	};

	tpdm_llm_lmh0: tpdm@1218f000 {
		compatible = "arm,primecell";
