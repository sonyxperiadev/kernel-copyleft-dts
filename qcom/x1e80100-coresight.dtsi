	tpda_apss: tpda@12197000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0f00>;
		reg = <0x0 0x12197000 0x0 0x1000>;
		reg-names = "tpda-base";

		device-name = "tpda_apss";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				tpda_apss_in_tpdm_llm_lmh0: endpoint {
					remote-endpoint =
					<&tpdm_llm_lmh0_out_tpda_apss>;
				};
			};

			port@1 {
				reg = <1>;
				tpda_apss_in_tpdm_llm_lmh1: endpoint {
					remote-endpoint =
					<&tpdm_llm_lmh1_out_tpda_apss>;
				};
			};

			port@2 {
				reg = <2>;
				tpda_apss_in_tpdm_llm_lmh2: endpoint {
					remote-endpoint =
					<&tpdm_llm_lmh2_out_tpda_apss>;
				};
			};

			port@3 {
				reg = <3>;
				tpda_apss_in_tpdm_ext_dsb0: endpoint {
					remote-endpoint =
					<&tpdm_ext_dsb0_out_tpda_apss>;
				};
			};

			port@4 {
				reg = <4>;
				tpda_apss_in_tpdm_ext_dsb1: endpoint {
					remote-endpoint =
					<&tpdm_ext_dsb1_out_tpda_apss>;
				};
			};

			port@5 {
				reg = <5>;
				tpda_apss_in_tpdm_ext_dsb2: endpoint {
					remote-endpoint =
					<&tpdm_ext_dsb2_out_tpda_apss>;
				};
			};

			port@6 {
				reg = <6>;
				tpda_apss_in_tpdm_ext_dsb3: endpoint {
					remote-endpoint =
					<&tpdm_ext_dsb3_out_tpda_apss>;
				};
			};

			port@7 {
				reg = <7>;
				tpda_apss_in_tpdm_ext_dsb4: endpoint {
					remote-endpoint =
					<&tpdm_ext_dsb4_out_tpda_apss>;
				};
			};

