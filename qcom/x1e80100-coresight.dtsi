		device-name = "tmc_etr1";

		iommus = <&apps_smmu 0x0500 0x0>;
		memory-region = <&tmc_etr1_region>;
		dma-coherent;
		arm,scatter-gather;

		coresight-csr = <&csr>;
		csr-atid-offset = <0x108>;
		csr-irqctrl-offset = <0x70>;
		byte-cntr-name = "byte-cntr1";
		byte-cntr-class-name = "coresight-tmc-etr1-stream";
		interrupts = <GIC_SPI 269 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "byte-cntr-irq";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			port {
				tmc_etr1_in_replicator_dummy: endpoint {
					remote-endpoint =
					<&replicator_dummy_out_tmc_etr1>;
				};
			};
		};

		tmc_etr1_region: tmc_etr1_region {
			iommu-addresses = <&tmc_etr1 0x1 0x0 0xfe 0x0>;
		};
	};

	cti@10010000 {
		compatible = "arm,coresight-cti", "arm,primecell";
		reg = <0x0 0x10010000 0x0 0x1000>;

		arm,primecell-periphid = <0x000bb922>;
		device-name = "cti_qdss";

		qcom,extended_cti;
		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		qcom,cti-gpio-trigout = <20>;
		pinctrl-names = "cti-trigout-pctrl";

		#address-cells = <1>;
		#size-cells = <0>;

		trig-conns@0 {
			reg = <0>;
			arm,trig-out-sigs = <3>;
			arm,cs-dev-assoc = <&tmc_etr>;
		};

		trig-conns@1 {
			reg = <1>;
			arm,trig-out-sigs = <16 20>;
		};

		trig-conns@2 {
			reg = <2>;
			arm,trig-out-sigs = <4 5 6 7>;
		};

		trig-conns@3 {
			reg = <3>;
			arm,trig-out-sigs = <27>;
			arm,cs-dev-assoc = <&tmc_etr1>;
		};
	};

