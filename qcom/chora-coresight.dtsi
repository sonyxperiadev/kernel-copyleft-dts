&soc {
	cti@10813000 {
		compatible = "arm,coresight-cti", "arm,primecell";
		reg = <0x0 0x10813000 0x0 0x1000>;

		arm,primecell-periphid = <0x000bb922>;
		device-name = "cti_mss2";

		status = "disabled";
		qcom,extended_cti;
		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	cti@1080b000 {
