	ipcb_tgu: tgu@10b0e000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;
		reg = <0x0 0x10b0e000 0x0 0x1000>;
		reg-names = "tgu-base";
		tgu-steps = <3>;
		tgu-conditions = <4>;
		tgu-regs = <5>;

		device-name = "tgu_ipcb";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	spmi_tgu0: tgu@10b0f000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;

		reg = <0x0 0x10b0f000 0x0 0x1000>;
		reg-names = "tgu-base";

		tgu-steps = <3>;
		tgu-conditions = <4>;
		tgu-regs = <8>;

		device-name = "tgu_spmi0";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	spmi_tgu1: tgu@10b10000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;

		reg = <0x0 0x10b10000 0x0 0x1000>;
		reg-names = "tgu-base";

		tgu-steps = <3>;
		tgu-conditions = <4>;
		tgu-regs = <8>;

		device-name = "tgu_spmi1";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	csr: csr@10001000 {
		compatible = "qcom,coresight-csr";
		reg = <0x0 0x10001000 0x0 0x1000>;
		reg-names = "csr-base";

		device-name = "csr";

		qcom,hwctrl-set-support;
		qcom,set-byte-cntr-support;
		qcom,blk-size = <1>;
	};

	swao_csr: csr@10b11000 {
		compatible = "qcom,coresight-csr";
		reg = <0x0 0x10b11000 0x0 0x1000>,
			  <0x0 0x10b110f8 0x0 0x70>;
		reg-names = "csr-base", "msr-base";

		device-name = "swao_csr";

		qcom,timestamp-support;
		qcom,msr-support;
		qcom,blk-size = <1>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	ddr_tpdm_channel_0_1: tpdm@10d20000 {
		compatible = "qcom,coresight-tpdm", "arm,primecell";
		reg = <0x0 0x10d20000 0x0 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <16>;

		device-name = "tpdm_ddr_01";
		status = "disabled";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				ddr_tpdm_channel_0_1_out_ddr_ch_0_1_dl_0: endpoint {
					remote-endpoint =
						<&ddr_ch_0_1_dl_0_in_ddr_tpdm_channel_0_1>;
				};
			};
		};
	};

	ddr_ch_0_1_dl: funnel@10d22000 {
		compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
		reg = <0x0 0x10d22000 0x0 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_ddr_ch01";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			port@0 {
				ddr_ch_0_1_dl_0_in_ddr_tpdm_channel_0_1: endpoint {
					remote-endpoint =
						<&ddr_tpdm_channel_0_1_out_ddr_ch_0_1_dl_0>;
				};
			};
		};

		out-ports {
			port {
				ddr_ch_0_1_dl_out_dl_0_ddr_0: endpoint {
					remote-endpoint =
						<&dl_0_ddr_0_in_ddr_ch_0_1_dl>;
				};
			};
		};
	};

	ddr_tpdm_ddr_dl_0_dsb_cmb: tpdm@10d00000 {
		compatible = "qcom,coresight-tpdm", "arm,primecell";
		reg = <0x0 0x10d00000 0x0 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <32>;
		qcom,cmb-element-bits = <32>;
		qcom,cmb-msrs-num = <1>;

		device-name = "tpdm_ddr_dl0";
		status = "disabled";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				ddr_tpdm_ddr_dl_0_dsb_cmb_out_dl_0_ddr_2: endpoint {
					remote-endpoint =
						<&dl_0_ddr_2_in_ddr_tpdm_ddr_dl_0_dsb_cmb>;
				};
			};
		};
	};

	ddr_tpdm_ddr_dpm: tpdm@10d01000 {
		compatible = "qcom,coresight-tpdm", "arm,primecell";
		reg = <0x0 0x10d01000 0x0 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <64>;
		qcom,cmb-msrs-num = <1>;

		device-name = "tpdm_ddr_dpm";
		status = "disabled";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				ddr_tpdm_ddr_dpm_out_dl_0_ddr_3: endpoint {
					remote-endpoint =
						<&dl_0_ddr_3_in_ddr_tpdm_ddr_dpm>;
				};
			};
		};
	};

	gladiator: gladiator {
		compatible = "arm,coresight-dummy-source";
		device-name = "gladiator";
		atid = <96>;

		out-ports {
			port {
				gladiator_out_dl_1_ddr: endpoint {
					remote-endpoint =
					<&dl_1_ddr_in_gladiator>;
				};
			};
		};
	};

	dl_1_ddr: funnel@10d0a000 {
		compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
		reg = <0x0 0x10d0a000 0x0 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_ddr_dl1";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			port@3 {
				reg = <3>;
				dl_1_ddr_in_gladiator: endpoint {
					remote-endpoint =
					<&gladiator_out_dl_1_ddr>;
				};
			};
		};

		out-ports {
			port {
				dl_1_ddr_out_dl_0_ddr_4: endpoint {
					remote-endpoint =
						<&dl_0_ddr_4_in_dl_1_ddr>;
				};
			};
		};
	};

	dl_0_ddr: funnel@10d03000 {
		compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
		reg = <0x0 0x10d03000 0x0 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_ddr_dl";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				dl_0_ddr_0_in_ddr_ch_0_1_dl: endpoint {
					remote-endpoint =
						<&ddr_ch_0_1_dl_out_dl_0_ddr_0>;
				};
			};

			port@2 {
				reg = <2>;
				dl_0_ddr_2_in_ddr_tpdm_ddr_dl_0_dsb_cmb: endpoint {
					remote-endpoint =
						<&ddr_tpdm_ddr_dl_0_dsb_cmb_out_dl_0_ddr_2>;
				};
			};

			port@3 {
				reg = <3>;
				dl_0_ddr_3_in_ddr_tpdm_ddr_dpm: endpoint {
					remote-endpoint =
						<&ddr_tpdm_ddr_dpm_out_dl_0_ddr_3>;
				};
			};

			port@4 {
				reg = <4>;
				dl_0_ddr_4_in_dl_1_ddr: endpoint {
					remote-endpoint =
						<&dl_1_ddr_out_dl_0_ddr_4>;
				};
			};
		};

		out-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				dl_0_ddr_out_dl_center0_2: endpoint {
					remote-endpoint =
						<&dl_center0_2_in_dl_0_ddr>;
				filter-source = <&gladiator>;
				};
			};

			port@1 {
				reg = <1>;
				dl_0_ddr_out_tpda_dlct0_4: endpoint {
					remote-endpoint =
						<&tpda_dlct0_4_in_dl_0_ddr>;
				filter-source = <&ddr_tpdm_channel_0_1>;
				};
			};

			port@2 {
				reg = <2>;
				dl_0_ddr_out_tpda_dlct0_6: endpoint {
					remote-endpoint =
						<&tpda_dlct0_6_in_dl_0_ddr>;
				filter-source = <&ddr_tpdm_ddr_dl_0_dsb_cmb>;
				};
			};

			port@3 {
				reg = <3>;
				dl_0_ddr_out_tpda_dlct0_7: endpoint {
					remote-endpoint =
						<&tpda_dlct0_7_in_dl_0_ddr>;
				filter-source = <&ddr_tpdm_ddr_dpm>;
				};
			};
		};
	};

