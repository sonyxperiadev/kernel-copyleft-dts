			nsp-supply = <&VDD_NSP_LEVEL>;
			nsp-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 100000>;
			reg-names = "cx","mx","nsp";

			interrupts-extended = <&intc GIC_SPI 578 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "wdog",
					  "fatal",
					  "ready",
					  "handover",
					  "stop-ack";

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";

			interconnects = <&nsp_noc MASTER_CDSP_PROC &mc_virt SLAVE_EBI1>,
					<&aggre2_noc MASTER_CRYPTO &mc_virt SLAVE_EBI1>;
			interconnect-names = "rproc_ddr", "crypto_ddr";

			firmware-name = "cdsp.mdt", "cdsp_dtb.mdt";

			memory-region = <&cdsp_mem>,
					<&q6_cdsp_dtb_mem>;

			qcom,qmp = <&aoss_qmp>;

			qcom,smem-states = <&cdsp_smp2p_out 0>;
			qcom,smem-state-names = "stop";

			status = "okay";

			remoteproc_cdsp_glink: glink-edge {
				qcom,remote-pid = <5>;
				transport = "smem";
				mboxes = <&ipcc_mproc IPCC_CLIENT_CDSP
					  IPCC_MPROC_SIGNAL_GLINK_QMP>;
				mbox-names = "cdsp_smem";
				interrupt-parent = <&ipcc_mproc>;
				interrupts = <IPCC_CLIENT_CDSP
					      IPCC_MPROC_SIGNAL_GLINK_QMP
					      IRQ_TYPE_EDGE_RISING>;

				label = "cdsp";
				qcom,glink-label = "cdsp";

				qcom,cdsp_qrtr {
					qcom,glink-channels = "IPCRTR";
					qcom,intents = <0x800  5
							0x2000 3
							0x4400 2>;
				};
			};
		};
	};

	arch_timer: timer {
		compatible = "arm,armv8-timer";

		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};

	disp_rsc: rsc@af20000 {
		label = "disp_rsc";
		compatible = "qcom,rpmh-rsc";
		reg = <0x0 0xaf20000 0x0 0x10000>;
		reg-names = "drv-0";
		qcom,drv-count = <1>;
		interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&dispcc DISP_CC_MDSS_RSCC_AHB_CLK>;

		disp_rsc_drv0: drv@0 {
			qcom,drv-id = <0>;
			qcom,tcs-offset = <0x1c00>;
			qcom,tcs-distance = <0x2a0>;
			channel@0 {
				qcom,tcs-config = <ACTIVE_TCS    0>,
						  <SLEEP_TCS     1>,
						  <WAKE_TCS      1>,
						  <CONTROL_TCS   0>,
						  <FAST_PATH_TCS 0>;
			};
		};
	};

	sram@c3f0000 {
		compatible = "qcom,rpmh-stats-v4";
		reg = <0x0 0x0c3f0000 0x0 0x400>;
		qcom,qmp = <&aoss_qmp>;
		ss-name = "adsp", "adsp_island", "cdsp", "apss";
	};

	sys-pm-vx@c320000 {
		compatible = "qcom,sys-pm-violators", "qcom,sys-pm-x1e80100";
		reg = <0x0 0xc320000 0x0 0x400>;
		qcom,qmp = <&aoss_qmp>;
	};

	cluster_device0: cluster-device0 {
		compatible = "qcom,lpm-cluster-dev";
		power-domains = <&cluster_pd0>;
		qcom,pred-prem-cnt = <2>;
		qcom,sample-invalid-time = <40000000>;
	};

	cluster_device1: cluster-device1 {
		compatible = "qcom,lpm-cluster-dev";
		power-domains = <&cluster_pd1>;
		qcom,pred-prem-cnt = <2>;
		qcom,sample-invalid-time = <40000000>;
	};

	cluster_device2: cluster-device2 {
		compatible = "qcom,lpm-cluster-dev";
		power-domains = <&cluster_pd2>;
		qcom,pred-prem-cnt = <2>;
		qcom,sample-invalid-time = <40000000>;
	};

	cluster_device3: cluster-device3 {
		compatible = "qcom,lpm-cluster-dev";
		power-domains = <&system_pd>;
		qcom,pred-prem-cnt = <2>;
		qcom,sample-invalid-time = <40000000>;
	};
};

&tlmm {
	wlan_tps_3v3_enable_state: wlan-tps-3v3-enable {
		mux {
			pins = "gpio214";
			function = "gpio";
		};

		config {
			pins = "gpio214";
			bias-pull-up;
			output-high;
		};
	};
};

&{/} {
	vreg_wlan_3p3: wlan-3p3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vreg_wlan_3p3";

		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 214 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-names = "default";
		pinctrl-0 = <&wlan_tps_3v3_enable_state>;
	};
};

#include "msm-arm-smmu-x1e80100.dtsi"
#include "x1e80100-dma-heaps.dtsi"
#include "x1e80100-pinctrl.dtsi"
#include "x1e80100-qupv3.dtsi"
#include "x1e80100-pcie.dtsi"

&qupv3_se21_2uart {
	status = "ok";
};
#include "x1e80100-regulators.dtsi"
#include "x1e80100-debug.dtsi"
