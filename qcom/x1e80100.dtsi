			clock-names = "bi_tcxo",
				"gcc_usb4_0_phy_dp0_gmux_clk_src",
				"gcc_usb4_0_phy_dp1_gmux_clk_src",
				"gcc_usb4_0_phy_pcie_pipegmux_clk_src",
