	vbat {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&smb2360_0_bcl 2>;

		trips {
			vbat_lvl0:vbat-lvl0 {
				temperature = <2800>;
				hysteresis = <100>;
				type = "passive";
			};

			vbat_lvl1:vbat-lvl1 {
