			<0x1 CAM_CC_CPHY_RX_CLK_SRC		19661		33424	6>,
			<0x1 CAM_CC_IFE_LITE_CSID_CLK_SRC	419431		1967	2>,

			<0x4 VIDEO_CC_MVS0_CLK_SRC		1272054		64226	1>,
